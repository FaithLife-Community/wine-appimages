#!/bin/bash
# dxvk-uninstall: take DXVK out of a Wine prefix and go back to Wine's own Direct3D.
#
#   WINEPREFIX=<prefix> <AppImage> dxvk-uninstall
#
# Removes the DLL overrides dxvk-install set, deletes the DXVK DLLs (only files that
# are DXVK) and has wineboot put Wine's builtin DLLs back.
set -euo pipefail

WINE="$APPDIR/usr/bin/wine"
DLLS="d3d8 d3d9 d3d10core d3d11 dxgi"

[ -d "$WINEPREFIX/drive_c/windows/system32" ] || { echo "dxvk-uninstall: no Wine prefix at $WINEPREFIX" >&2; exit 1; }

for dll in $DLLS; do
	"$WINE" reg delete 'HKCU\Software\Wine\DllOverrides' /v "$dll" /f >/dev/null 2>&1 || true
	for dir in system32 syswow64; do
		f="$WINEPREFIX/drive_c/windows/$dir/$dll.dll"
		# Wine's own DLLs say so; leave anything that isn't DXVK alone.
		if [ -f "$f" ] && grep -qai "dxvk" "$f" && ! grep -qa "Wine builtin DLL" "$f"; then
			rm -f "$f"
		fi
	done
done
"$WINE" wineboot -u
"$APPDIR/usr/bin/wineserver" -w
echo "Removed DXVK from $WINEPREFIX"
