#!/bin/bash
# dxvk-install: put the DXVK bundled in this AppImage into a Wine prefix.
#
#   WINEPREFIX=<prefix> <AppImage> dxvk-install
#
# Copies DXVK's d3d8, d3d9, d3d10core, d3d11 and dxgi into the prefix (64-bit to
# system32, 32-bit to syswow64) and sets them to load as native. Undo with
# "<AppImage> dxvk-uninstall". DXVK needs a Vulkan 1.4 driver (Mesa 25+, NVIDIA 575+).
set -euo pipefail

DXVK="$APPDIR/opt/dxvk"
WINE="$APPDIR/usr/bin/wine"
DLLS="d3d8 d3d9 d3d10core d3d11 dxgi"

die() { echo "dxvk-install: $*" >&2; exit 1; }
[ -d "$DXVK/x64" ] || die "this AppImage has no DXVK bundled"
[ -d "$WINEPREFIX/drive_c/windows/system32" ] || die "no Wine prefix at $WINEPREFIX (run wineboot first)"

copy() {
	local from=$1 to=$2 dll
	[ -d "$to" ] || return 0
	for dll in $DLLS; do
		[ -f "$from/$dll.dll" ] && cp -f "$from/$dll.dll" "$to/$dll.dll"
	done
}
copy "$DXVK/x64" "$WINEPREFIX/drive_c/windows/system32"
copy "$DXVK/x32" "$WINEPREFIX/drive_c/windows/syswow64"

for dll in $DLLS; do
	"$WINE" reg add 'HKCU\Software\Wine\DllOverrides' /v "$dll" /d native /f >/dev/null
done
"$APPDIR/usr/bin/wineserver" -w

cat "$DXVK/VERSION" 2>/dev/null | sed 's/^/Installed /' || echo "Installed DXVK"
echo "into $WINEPREFIX"
